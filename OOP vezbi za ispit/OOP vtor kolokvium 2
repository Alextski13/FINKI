    }
}


int main() {

    wtf();

    Results results;
    ifstream fin("input.txt");
    string index, ime, prezime;
    int poeni;
    while(fin>>index>>ime>>prezime>>poeni){
        try{
            Student s(index,ime,prezime,poeni);
            results+=s;
        }catch(StudentFailedException& e){
            e.showmessage();
        }

    }
    ofstream fout1("output1.txt");
    fout1<<results;
    fout1.close();
    //DO NOT MODIFY THE CODE BETWEEN THIS AND THE NEXT COMMENT
    int grade;
    cin >> grade;
    //DO NOT MODIFY THE CODE BETWEEN THIS AND THE PREVIOUS COMMENT

    try{
        Results filtered = results.withGrade(grade);
        ofstream fout2("output2.txt");
        if(filtered.isEmpty()){
            fout2<<"None"<<endl;
        }
        else {
            fout2 << filtered;
        }
        fout2.close();
    }catch(StudentFailedException& s){
        s.showmessage();
        ofstream fout2("output2.txt");
        fout2<<" ";
        fout2.close();
    }




    //DO NOT MODIFY THE CODE BELLOW

    cout << "All students:" << endl;
